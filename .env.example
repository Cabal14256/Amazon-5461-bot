# === AdsPower ===
ADSPOWER_API_BASE_URL=http://local.adspower.net:50325
# ADSPOWER_API_KEY=your_api_key_if_enabled

# === Local private account config ===
# Put real account config at runtime/private/accounts.json and point the project to it.
# Optional override; normally auto-detected when runtime/private/accounts.json exists
# AMAZON5461_ACCOUNTS_PATH=runtime/private/accounts.json

# === Runtime ===
TZ=Asia/Hong_Kong
AMAZON5461_DEFAULT_DRY_RUN=true
AMAZON5461_REQUIRE_CONFIRM_BEFORE_SUBMIT=true

# === Feishu Bitable (keep real values in .env only) ===
# FEISHU_APP_ID=cli_your_app_id
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_WIKI_NODE_TOKEN=your_wiki_node_token
# FEISHU_BITABLE_APP_TOKEN=
# FEISHU_BITABLE_TABLE_ID=tbl_your_table_id
# FEISHU_BITABLE_VIEW_ID=
# FEISHU_BITABLE_ENABLED=true
# FEISHU_BIND_ON_SCHEDULE=true
# FEISHU_BITABLE_WRITE_ENABLED=false

# === Optional LLM page analysis ===
# LLM_ENABLED=false
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL=https://api.example.com/v1
# AMAZON5461_LLM_MODEL=gpt-4o-mini
# LLM_SUPPORTS_VISION=true
